# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# Postgres connection string.
# On Railway this is injected automatically as DATABASE_URL by the Postgres
# addon; you only set it here for local development. Use the *public* URL from
# the Railway dashboard (Postgres service -> Variables -> DATABASE_PUBLIC_URL)
# so you can reach it from this machine.
DATABASE_URL=postgresql://postgres:password@localhost:5432/gugame

# Discord bot token (https://discord.com/developers/applications).
DISCORD_TOKEN=

# Guild the slash commands register to. Leave blank to register globally
# (slower to propagate — set this during development).
GUILD_ID=
