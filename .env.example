# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# Postgres connection string.
# On Railway this is injected automatically as DATABASE_URL by the Postgres
# addon; you only set it here for local development. Use the *public* URL from
# the Railway dashboard (Postgres service -> Variables -> DATABASE_PUBLIC_URL)
# so you can reach it from this machine.
DATABASE_URL=postgresql://postgres:password@localhost:5432/gugame

# Discord bot token (https://discord.com/developers/applications).
DISCORD_TOKEN=

# Guild the slash commands register to. Leave blank to register globally
# (slower to propagate — set this during development).
GUILD_ID=

# Channel a slain world beast is announced in. Leave empty to
# announce nowhere - the fight itself works either way.
BOSS_CHANNEL_ID=
# Where a Beast Horde runs. Leave empty to run none.
HORDE_CHANNEL_ID=

# Register the /dev group (13 owner-only subcommands on one slash-command slot).
# Off by default: the tree holds 100 of Discord's 100 commands, and this is the
# cheapest slot to buy back. The cog stays on disk either way, and the test
# suite loads it regardless - this only controls what Discord is told about.
DEV_COMMANDS=
